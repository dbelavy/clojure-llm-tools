#!/usr/bin/env bash
# repo-root — resolve repository and project locations without hardcoding a host layout.
#
# WHY THIS EXISTS
#   Two agents share these repos from different hosts, and each hardcoded its own
#   local path into the shared skill. Every "fix" to one layout broke the other, and
#   the skill ended up asserting things that were false on the machine it was
#   installed on. Worse, a stale checkout of the same repo sat in a synced folder
#   with a different git remote, so "which path" was never the real question — which
#   copy is canonical, was.
#
# THE RULE
#   The Syncthing shared folder is canonical for all repositories and projects.
#   A Syncthing folder root is any directory containing a `.stfolder` marker.
#   Canonical subdirectories are `repos/` (git repositories) and `projects/`
#   (non-repo projects, e.g. cljgen, sexpsplice).
#
# MULTIPLE ROOTS — why discovery is RANKED, not first-match
#   A host can carry more than one `.stfolder` (e.g. a live shared folder plus a
#   stale agent workspace bind-mounted over an old one). Taking the first hit is
#   wrong: it silently resolves to a partial mirror and then reports real repos as
#   "not found". So candidates are ranked:
#     1. most entries in the subdirectory — a canonical root is a superset of a
#                                          stale partial mirror
#     2. shallower path                   — a nested copy is usually the stale one
#     3. lexicographic                    — determinism
#   And `repo-root <name>` searches EVERY root, so a repo that lives only in a
#   lower-ranked root is still found rather than reported missing.
#
# USAGE
#   repo-root                 # path to the clojure-llm-tools repo
#   repo-root <name>          # any repo, searched across all discovered roots
#   repo-root --repos-root    # the canonical repos root itself
#   repo-root --projects-root # the canonical projects root itself
#   repo-root --list          # every candidate root, ranked, with the winner
#
# OVERRIDES (for tests, unusual layouts, other hosts)
#   $REPOS_ROOT, $PROJECTS_ROOT  — win outright, no ranking
#   $CLJ_TOOLS_ROOT              — legacy, an explicit clojure-llm-tools checkout
#
# Exit 0 and print the path, or exit 1 with a diagnostic on stderr. It never
# guesses: a wrong path is worse than a clear failure, because an agent will
# happily use it.
set -euo pipefail

DEFAULT_REPO="clojure-llm-tools"

usable() { [ -n "${1:-}" ] && [ -d "$1" ]; }

# --- discovery -----------------------------------------------------------------
# Any directory holding a Syncthing `.stfolder` marker is a synced-folder root.
# Bounded depth keeps this fast; it is a convention marker, not a host path.
discover_sync_roots() {
  find "$HOME" -maxdepth 4 -name .stfolder -printf '%h\n' 2>/dev/null || true
}

# Ranked candidates for a given subdirectory name ("repos" or "projects").
# Emits: <entry count>\t<path depth>\t<absolute path>, best first.
ranked_roots() {
  local sub="$1" r dir n d
  while IFS= read -r r; do
    dir="$r/$sub"
    [ -d "$dir" ] || continue
    n=$(find "$dir" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
    d=$(printf '%s' "$dir" | awk -F/ '{print NF}')
    printf '%s\t%s\t%s\n' "$n" "$d" "$dir"
  done < <(discover_sync_roots) | sort -k1,1nr -k2,2n -k3,3
}

# Best-ranked candidate for a subdirectory, else the first usable legacy path.
best_root() {
  local sub="$1"; shift
  local line dir
  line="$(ranked_roots "$sub" | head -1 || true)"
  if [ -n "$line" ]; then
    dir="$(printf '%s' "$line" | cut -f3)"
    (cd "$dir" && pwd -P)
    return 0
  fi
  for dir in "$@"; do
    if usable "$dir"; then (cd "$dir" && pwd -P); return 0; fi
  done
  return 1
}

repos_root() {
  if usable "${REPOS_ROOT:-}"; then (cd "$REPOS_ROOT" && pwd -P); return 0; fi
  best_root repos "$HOME/repos" "$HOME/Shared/repos"
}

projects_root() {
  if usable "${PROJECTS_ROOT:-}"; then (cd "$PROJECTS_ROOT" && pwd -P); return 0; fi
  best_root projects "$HOME/projects"
}

# --- dispatch ------------------------------------------------------------------
case "${1:-}" in
  --repos-root)
    repos_root || { echo "repo-root: no canonical repos root found." >&2; exit 1; }
    exit 0 ;;
  --projects-root)
    projects_root || { echo "repo-root: no canonical projects root found." >&2; exit 1; }
    exit 0 ;;
  --list)
    echo "discovered sync roots (dirs containing .stfolder):"
    discover_sync_roots | sed 's/^/  /' || true
    for sub in repos projects; do
      echo ""
      echo "$sub candidates (ranked: entry count desc, depth asc, path):"
      ranked_roots "$sub" | awk -F'\t' '{printf "  %4s entries  depth %-3s  %s\n", $1, $2, $3}' || true
      printf '  winner: %s\n' "$(best_root "$sub" "$HOME/$sub" 2>/dev/null || echo '<unresolved>')"
    done
    exit 0 ;;
  ""|--repo)
    NAME="$DEFAULT_REPO" ;;
  *)
    NAME="$1" ;;
esac

# Legacy override: an explicit checkout of clojure-llm-tools, for tests and odd layouts.
if [ "$NAME" = "$DEFAULT_REPO" ] && usable "${CLJ_TOOLS_ROOT:-}"; then
  (cd "$CLJ_TOOLS_ROOT" && pwd -P); exit 0
fi

# Already inside the target repo? git is the authority on the top level.
if root="$(git rev-parse --show-toplevel 2>/dev/null)" && [ "$(basename "$root")" = "$NAME" ]; then
  (cd "$root" && pwd -P); exit 0
fi

# Search EVERY ranked root, not just the best: a repo that lives only in a
# lower-ranked root must still be found rather than reported missing.
while IFS= read -r line; do
  dir="$(printf '%s' "$line" | cut -f3)"
  if usable "$dir/$NAME"; then (cd "$dir/$NAME" && pwd -P); exit 0; fi
done < <(ranked_roots repos)

for dir in "$HOME/repos/$NAME" "$HOME/Shared/repos/$NAME"; do
  if usable "$dir"; then (cd "$dir" && pwd -P); exit 0; fi
done

echo "repo-root: '$NAME' not found in any discovered repos root." >&2
echo "  Run 'repo-root --list' to see the ranked candidates." >&2
echo "  Override with REPOS_ROOT=/path/to/repos if this host differs." >&2
exit 1
